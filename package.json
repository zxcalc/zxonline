{
  "name": "zxonline",
  "type": "module",
  "displayName": "ZX Online",
  "description": "Learning quantum theory with the ZX-calculus",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxcalc/zxonline.git"
  },
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:website": "npm run build && node scripts/sync-website-canvas.mjs",
    "serve:website": "npm run build:website && node scripts/serve-website.mjs",
    "build-test": "vite build --mode test",
    "watch-test": "vite build --mode test --watch",
    "lint": "tsc && eslint .",
    "test": "mocha dist/tests.js",
    "pretest": "npm run build-test",
    "analyze": "vite-bundle-analyzer"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.3",
    "args-tokenizer": "^0.3.0",
    "chevrotain": "^11.1.1",
    "preact": "^10.28.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.0",
    "chai": "^6.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "mocha": "^11.7.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-bundle-analyzer": "^1.3.6"
  }
}
